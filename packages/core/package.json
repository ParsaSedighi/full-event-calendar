{
  "name": "@roozaneh/core",
  "version": "0.1.0",
  "description": "Core event calendar engine (Solid.js) that powers roozaneh.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "grid",
    "calendar",
    "calendar drag n drop"
  ],
  "author": "Amirkian Adl <amircc1200@gmail.com>",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts && pnpm run build-css",
    "build:fast": "tsup src/index.ts && pnpm run build-css",
    "dev": "pnpm build:fast -- --watch",
    "build-css": "vite build"
  },
  "devDependencies": {
    "esbuild-sass-plugin": "^2.16.0",
    "sass": "^1.64.2",
    "tsup-preset-solid": "^2.1.0",
    "typescript": "^5.1.3",
    "vite": "^4.3.9",
    "vite-dts": "^1.0.4",
    "vite-plugin-dts": "3.0.0",
    "vite-plugin-solid": "^2.7.0",
    "@roozaneh/shared-ts": "workspace:*",
    "@roozaneh/basic-grid": "workspace:*",
    "@roozaneh/daily-grid": "workspace:*",
    "@roozaneh/weekly-grid": "workspace:*",
    "@roozaneh/month-grid": "workspace:*",
    "@roozaneh/list": "workspace:*"
  },
  "dependencies": {
    "@roozaneh/utils": "workspace:^",
    "redux": "^4.2.1",
    "solid-js": "^1.7.7",
    "solid-transition-group": "^0.2.3",
    "@roozaneh/locale": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": ">=1.0.0"
  }
}
