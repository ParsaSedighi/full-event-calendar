{
  "name": "@roozaneh/utils",
  "version": "0.1.0",
  "description": "Shared utilities for roozaneh packages.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "grid",
    "calendar",
    "calendar drag n drop"
  ],
  "author": "Amirkian Adl <amircc1200@gmail.com>",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@roozaneh/shared-ts": "workspace:*",
    "framer-motion": "^10.16.1"
