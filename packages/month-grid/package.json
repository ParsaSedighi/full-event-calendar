{
  "name": "@roozaneh/month-grid",
  "version": "0.1.0",
  "description": "Month view plugin for roozaneh.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "grid",
    "calendar",
    "calendar drag n drop"
  ],
  "author": "Amirkian Adl <amircc1200@gmail.com>",
  "contributors": [
    "Parsa Sedighi"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@roozaneh/shared-ts": "workspace:*",
    "clean-package": "2.2.0",
    "framer-motion": "^10.16.1"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts",
    "build:fast": "tsup src/index.ts",
    "dev": "pnpm build:fast -- --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "typedocs": "tsx ../../../scripts/generate-type-docs.ts"
  },
  "dependencies": {
    "@roozaneh/utils": "workspace:^",
    "esbuild-sass-plugin": "^2.16.0",
    "solid-transition-group": "^0.2.3",
    "@roozaneh/locale": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": ">=1.0.0"
  }
}
