{
  "name": "roozaneh",
  "version": "0.1.0",
  "description": "React wrapper for roozaneh: a fast, lightweight full-featured event calendar with drag & drop, supporting the Persian (Jalali) calendar and many more.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "react",
    "reactjs",
    "calendar",
    "event",
    "event-calendar",
    "persian",
    "jalali",
    "drag-and-drop"
  ],
  "author": "Amirkian Adl <amircc1200@gmail.com>",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts",
    "build-demo": "vite build",
    "dev": "vite",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@roozaneh/core": "workspace:^",
    "@roozaneh/daily-grid": "workspace:^",
    "@roozaneh/list": "workspace:^",
    "@roozaneh/locale": "workspace:^",
    "@roozaneh/month-grid": "workspace:^",
    "@roozaneh/weekly-grid": "workspace:^",
    "fast-deep-equal": "^3.1.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.0"
  },
  "peerDependencies": {
    "react": "^16.7.0 || ^17 || ^18",
    "react-dom": "^16.7.0 || ^17 || ^18"
  }
}
