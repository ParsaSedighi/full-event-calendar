{
  "name": "@roozaneh/daily-grid",
  "version": "0.1.0",
  "description": "Daily view plugin for roozaneh.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "grid",
    "calendar",
    "calendar drag n drop"
  ],
  "author": "Amirkian Adl <amircc1200@gmail.com>",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@roozaneh/shared-ts": "workspace:*",
    "clean-package": "2.2.0",
    "framer-motion": "^10.16.1",
    "rollup-preset-solid": "^2.0.1",
    "esbuild-sass-plugin": "^2.16.0"
  },
  "scripts": {
    "build1": "rollup -c",
    "build": "tsup src/index.ts --dts",
    "build:fast": "tsup src/index.ts",
    "dev": "pnpm build:fast -- --watch",
    "devw": "pnpm build:fast --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "typedocs": "tsx ../../../scripts/generate-type-docs.ts"
  },
  "dependencies": {
    "@roozaneh/basic-grid": "workspace:^",
    "@roozaneh/utils": "workspace:^",
    "@roozaneh/group-grid": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": ">=1.0.0"
  }
}
