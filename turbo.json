{
  "$schema": "https://turborepo.org/schema.json",
  "pipeline": {
    "build": {
      "outputs": ["dist/**"]
    },
    "build:fast": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^dev"]
    },
    "typecheck": {
      "cache": false,
      "dependsOn": ["^typecheck"]
    },
    "@roozaneh/basic-grid#build": {
      "dependsOn": ["@roozaneh/utils#build", "@roozaneh/locale#build"]
    },
    "@roozaneh/daily-grid#build": {
      "dependsOn": ["@roozaneh/shared-ts#build"]
    },
    "@roozaneh/group-grid#build": {
      "dependsOn": ["@roozaneh/utils#build", "@roozaneh/shared-ts#build"]
    },
    "@roozaneh/list#build": {
      "dependsOn": ["@roozaneh/utils#build", "@roozaneh/locale#build"]
    },
    "@roozaneh/month-grid#build": {
      "dependsOn": ["@roozaneh/utils#build", "@roozaneh/locale#build"]
    },
    "@roozaneh/shared-ts#build": {
      "dependsOn": []
    },
    "@roozaneh/utils#build": {
      "dependsOn": ["@roozaneh/shared-ts#build"]
    },
    "@roozaneh/weekly-grid#build": {
      "dependsOn": [
        "@roozaneh/utils#build",
        "@roozaneh/locale#build",
        "@roozaneh/month-grid#build",
        "@roozaneh/daily-grid#build",
        "@roozaneh/basic-grid#build",
        "@roozaneh/group-grid#build"
      ]
    },
    "@roozaneh/locale#build": {
      "dependsOn": []
    },

    "@roozaneh/core#build": {
      "dependsOn": [
        "@roozaneh/basic-grid#build",
        "@roozaneh/daily-grid#build",
        "@roozaneh/group-grid#build",
        "@roozaneh/list#build",
        "@roozaneh/month-grid#build",
        "@roozaneh/shared-ts#build",
        "@roozaneh/utils#build",
        "@roozaneh/weekly-grid#build",
        "@roozaneh/locale#build"
      ]
    }
  },
  "globalDependencies": ["tsconfig.json"]
}
