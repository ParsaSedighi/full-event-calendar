{
  "$schema": "https://turborepo.org/schema.json",
  "pipeline": {
    "build": {
      "outputs": ["dist/**"]
    },
    "build:fast": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^dev"]
    },
    "typecheck": {
      "cache": false,
      "dependsOn": ["^typecheck"]
    },
    "@full-event-calendar/basic-grid#build": {
      "dependsOn": ["@full-event-calendar/utils#build", "@full-event-calendar/locale#build"]
    },
    "@full-event-calendar/daily-grid#build": {
      "dependsOn": ["@full-event-calendar/shared-ts#build"]
    },
    "@full-event-calendar/group-grid#build": {
      "dependsOn": ["@full-event-calendar/utils#build", "@full-event-calendar/shared-ts#build"]
    },
    "@full-event-calendar/list#build": {
      "dependsOn": ["@full-event-calendar/utils#build", "@full-event-calendar/locale#build"]
    },
    "@full-event-calendar/month-grid#build": {
      "dependsOn": ["@full-event-calendar/utils#build", "@full-event-calendar/locale#build"]
    },
    "@full-event-calendar/shared-ts#build": {
      "dependsOn": []
    },
    "@full-event-calendar/utils#build": {
      "dependsOn": ["@full-event-calendar/shared-ts#build"]
    },
    "@full-event-calendar/weekly-grid#build": {
      "dependsOn": [
        "@full-event-calendar/utils#build",
        "@full-event-calendar/locale#build",
        "@full-event-calendar/month-grid#build",
        "@full-event-calendar/daily-grid#build",
        "@full-event-calendar/basic-grid#build",
        "@full-event-calendar/group-grid#build"
      ]
    },
    "@full-event-calendar/locale#build": {
      "dependsOn": []
    },

    "@full-event-calendar/core#build": {
      "dependsOn": [
        "@full-event-calendar/basic-grid#build",
        "@full-event-calendar/daily-grid#build",
        "@full-event-calendar/group-grid#build",
        "@full-event-calendar/list#build",
        "@full-event-calendar/month-grid#build",
        "@full-event-calendar/shared-ts#build",
        "@full-event-calendar/utils#build",
        "@full-event-calendar/weekly-grid#build",
        "@full-event-calendar/locale#build"
      ]
    }
  },
  "globalDependencies": ["tsconfig.json"]
}
