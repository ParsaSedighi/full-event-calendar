{
  "private": true,
  "name": "@roozaneh/root",
  "description": "Roozaneh: a full-featured event calendar for React with drag and drop",
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "calendar",
    "event",
    "full-sized",
    "calendarview"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "format": "prettier --write",
    "build": "pnpm -r build && node ./scripts/build.js",
    "precommit": "pretty-quick --staged",
    "commitmsg": "node scripts/verify.js",
    "prepare": "husky install .husky",
    "build-css": "pnpm -r build-css"
  },
  "author": "Amirkian adl",
  "license": "MIT",
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^13.1.0",
    "prettier": "^2.8.0",
    "pretty-quick": "^3.1.3"
  },
  "dependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "picocolors": "^1.0.0",
    "tsup": "^7.3.0",
    "tsup-preset-solid": "^2.1.0",
    "turbo": "^1.10.16",
    "typescript": "^5.1.3",
    "vite": "^5.0.2",
    "vite-plugin-solid": "^2.7.0"
  }
}
